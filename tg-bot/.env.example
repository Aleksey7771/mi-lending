# ── Обязательные ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
OPENROUTER_API_KEY=your_openrouter_key_here
ALLOWED_USER_ID=123456789          # ваш Telegram user ID

# ── AI модели (OpenRouter) ────────────────────────────────────────────────────
CONTENT_MODEL=deepseek/deepseek-chat
DIALOG_MODEL=anthropic/claude-haiku-5-5
ROUTER_MODEL=anthropic/claude-haiku-5-5

# ── Telegram канал ────────────────────────────────────────────────────────────
TELEGRAM_CHANNEL_ID=@your_channel

# ── Max боты ─────────────────────────────────────────────────────────────────
MAX_CONTENT_BOT_TOKEN=your_max_content_bot_token
MAX_CONTENT_CHANNEL_ID=your_max_channel_id
MAX_DIALOG_BOT_TOKEN=your_max_dialog_bot_token

# ── Бизнес-настройки ─────────────────────────────────────────────────────────
MANAGER_CONTACT=@your_manager_username
RESPONSE_TIME_HOURS=2
