# ============================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# ============================

# Telegram бот (получить у @BotFather)
BOT_TOKEN=

# Ваш Telegram ID (получить у @userinfobot)
OWNER_TELEGRAM_ID=

# OpenAI API (platform.openai.com/api-keys)
OPENAI_API_KEY=

# PostgreSQL
POSTGRES_DB=fish_agent
POSTGRES_USER=fish_agent
POSTGRES_PASSWORD=change_me_strong_password

# ============================
# ОПЦИОНАЛЬНЫЕ
# ============================

# OpenAI model (по умолчанию gpt-4o)
# OPENAI_MODEL=gpt-4o

# Redis (по умолчанию redis:6379 — для Docker не менять)
# REDIS_HOST=redis
# REDIS_PORT=6379

# PostgreSQL host (для Docker не менять, по умолчанию postgres)
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# 2GIS API (для парсинга клиентов)
TWOGIS_API_KEY=

# Email (SMTP/IMAP для рассылок и чтения писем)
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=sm43.hosting.reg.ru
SMTP_PORT=465
IMAP_HOST=sm43.hosting.reg.ru
IMAP_PORT=993

# OpenAI Whisper (для голосового ввода)
OPENAI_API_KEY=

# Telegram-канал для автопостинга (@username или -100xxxxxxxxxx)
CHANNEL_ID=

# Postmately MCP server (create the API key in Postmately settings)
POSTMATELY_API_KEY=
# Optional if more than one Telegram channel is connected in Postmately
POSTMATELY_TELEGRAM_CHANNEL_ID=
# POSTMATELY_MCP_URL=https://api.postmately.com/mcp

# Telegram MTProto (для парсинга групп — получить на my.telegram.org)
TG_API_ID=0
TG_API_HASH=
TG_GROUPS=

# Данные компании (для PDF прайса)
COMPANY_NAME=Торговый рыбный дом
COMPANY_PHONE=+7 XXX XXX-XX-XX
COMPANY_TELEGRAM=@your_telegram
COMPANY_EMAIL=
COMPANY_CONDITIONS=Минимальный заказ 50 кг.

# Расписание
# MORNING_DIGEST_HOUR=9
# MORNING_DIGEST_TZ=Asia/Vladivostok
# PARSER_INTERVAL_MINUTES=60
